<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/progress_bar_drawable.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo de la barra de progreso -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E0E0E0"/> <!-- Color de fondo -->
        </shape>
    </item>

    <!-- Barra de progreso -->
    <item>
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/secondaryBlue"/> <!-- Color de la barra de progreso -->
            </shape>
        </clip>
    </item>
</layer-list>